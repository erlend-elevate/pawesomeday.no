{%- comment -%}
  templates/page.17mai-rabatt.liquid

  17. mai kundeklubb-rabatt landingsside.
  Strukturen er gjenbrukbar for fremtidige kampanjer (Black Week, påske, sommer):
  endre Liquid-variablene under for ny kode, prosent, datoer, collections og produkter.

  Krever:
   * Page med handle 17mai-rabatt opprettet i Shopify Admin (Pages)
   * Discount-koden 17MAI opprettet med 17 % og collection-restriksjon på de to handles
   * Templaten er selvinneholdt: CSS er inline i <style>-blokken under, ingen ekstra asset trengs.
{%- endcomment -%}

{%- liquid
  assign campaign_code = '17MAI'
  assign campaign_percent_text = '17 %'
  assign campaign_deadline_text = 'til og med 17. mai'
  assign campaign_eyebrow = 'KUNDEKLUBB-EKSKLUSIVT'

  assign campaign_collection_handle = '17-mai-i-kampanje-for-nyhetsbrev-og-kundeklubb'
  assign tygg_handle = 'alt-av-tygg'
  assign tygg_count = 21
  assign hjernetrim_handle = 'alle-hjernetrims-og-aktiviseringsleker'
  assign hjernetrim_count = 67
  assign hjernetrim_query = '?filter.v.availability=1'

  assign featured_handles_str = 'frysetorket-okse-pizzle-naturlig-og-langvarig-tygg-til-hund,pawesomeday-slowfeeder-slowfeeder-til-hund,hjerte-slowfeeder-lickmat'
  assign featured_handles = featured_handles_str | split: ','

  assign campaign_path = '/collections/' | append: campaign_collection_handle
  assign tygg_path = '/collections/' | append: tygg_handle
  assign hjernetrim_path = '/collections/' | append: hjernetrim_handle | append: hjernetrim_query

  assign campaign_redirect = campaign_path | url_encode
  assign tygg_redirect = tygg_path | url_encode
  assign hjernetrim_redirect = hjernetrim_path | url_encode

  assign campaign_cta = '/discount/' | append: campaign_code | append: '?redirect=' | append: campaign_redirect
  assign tygg_cta = '/discount/' | append: campaign_code | append: '?redirect=' | append: tygg_redirect
  assign hjernetrim_cta = '/discount/' | append: campaign_code | append: '?redirect=' | append: hjernetrim_redirect

  assign market_handle = localization.market.handle | default: ''
  assign foreign_markets = 'sweden,eu' | split: ','
  assign foreign_market = false
  if foreign_markets contains market_handle
    assign foreign_market = true
  endif
-%}

<style>
  .pmd-page {
    --pmd-bg: #FFFFFF;
    --pmd-text: #000000;
    --pmd-btn-bg: #111111;
    --pmd-btn-text: #FFFFFF;
    --pmd-border: #E8E8E1;
    --pmd-accent: #B8860B;
    --pmd-bg-soft: #F8F7F3;
    --pmd-container: 1200px;
    color: var(--pmd-text);
    background: var(--pmd-bg);
    font-family: 'Fahkwang', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 300;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .pmd-page * { box-sizing: border-box; }
  .pmd-container {
    max-width: var(--pmd-container);
    margin: 0 auto;
    padding-left: 16px;
    padding-right: 16px;
  }
  @media (min-width: 750px) {
    .pmd-container { padding-left: 32px; padding-right: 32px; }
  }
  .pmd-section {
    padding-top: clamp(48px, 8vw, 96px);
    padding-bottom: clamp(48px, 8vw, 96px);
  }
  .pmd-section--soft { background: var(--pmd-bg-soft); }
  .pmd-section--dark { background: var(--pmd-btn-bg); color: var(--pmd-btn-text); }
  .pmd-eyebrow {
    font-size: 12px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 400;
    margin: 0 0 16px;
  }
  .pmd-h1 {
    font-size: clamp(36px, 6vw, 56px);
    font-weight: 300;
    letter-spacing: 0.025em;
    line-height: 1.15;
    margin: 0 0 20px;
  }
  .pmd-h2 {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 300;
    letter-spacing: 0.025em;
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .pmd-h3 {
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 300;
    letter-spacing: 0.025em;
    line-height: 1.3;
    margin: 0 0 12px;
  }
  .pmd-lead {
    font-size: clamp(15px, 1.6vw, 17px);
    margin: 0 0 24px;
    max-width: 60ch;
  }
  .pmd-section--center { text-align: center; }
  .pmd-section--center .pmd-lead { margin-left: auto; margin-right: auto; }
  .pmd-btn {
    display: inline-block;
    padding: 14px 28px;
    font-family: inherit;
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border: 1px solid var(--pmd-btn-bg);
    border-radius: 0;
    cursor: pointer;
    transition: opacity 0.2s ease;
    line-height: 1.2;
  }
  .pmd-btn:hover, .pmd-btn:focus-visible { opacity: 0.85; }
  .pmd-btn--primary { background: var(--pmd-btn-bg); color: var(--pmd-btn-text); }
  .pmd-btn--secondary { background: transparent; color: var(--pmd-btn-bg); }
  .pmd-page a.pmd-btn,
  .pmd-page a.pmd-btn:visited,
  .pmd-page a.pmd-btn:hover,
  .pmd-page a.pmd-btn:focus,
  .pmd-page a.pmd-btn:active { text-decoration: none; }
  .pmd-page a.pmd-btn--primary,
  .pmd-page a.pmd-btn--primary:visited,
  .pmd-page a.pmd-btn--primary:hover,
  .pmd-page a.pmd-btn--primary:focus,
  .pmd-page a.pmd-btn--primary:active { color: #FFFFFF !important; }
  .pmd-page a.pmd-btn--secondary,
  .pmd-page a.pmd-btn--secondary:visited,
  .pmd-page a.pmd-btn--secondary:hover,
  .pmd-page a.pmd-btn--secondary:focus,
  .pmd-page a.pmd-btn--secondary:active { color: #111111 !important; }
  .pmd-section--dark .pmd-btn--primary {
    background: var(--pmd-btn-text);
    color: var(--pmd-btn-bg);
    border-color: var(--pmd-btn-text);
  }
  .pmd-page .pmd-section--dark a.pmd-btn--primary,
  .pmd-page .pmd-section--dark a.pmd-btn--primary:visited,
  .pmd-page .pmd-section--dark a.pmd-btn--primary:hover,
  .pmd-page .pmd-section--dark a.pmd-btn--primary:focus,
  .pmd-page .pmd-section--dark a.pmd-btn--primary:active { color: #111111 !important; }
  .pmd-cta-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .pmd-section--center .pmd-cta-row { justify-content: center; }
  .pmd-hero { text-align: center; border-bottom: 1px solid var(--pmd-border); }
  .pmd-hero__highlight { color: var(--pmd-accent); }
  .pmd-code-box {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid var(--pmd-text);
    margin: 24px 0 16px;
    max-width: 100%;
  }
  .pmd-code-box__code {
    padding: 14px 24px;
    font-size: clamp(20px, 3vw, 28px);
    font-weight: 400;
    letter-spacing: 0.2em;
    font-family: inherit;
    display: inline-flex;
    align-items: center;
  }
  .pmd-code-box__btn {
    font-family: inherit;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: var(--pmd-text);
    color: var(--pmd-bg);
    border: none;
    border-radius: 0;
    padding: 0 20px;
    cursor: pointer;
    transition: opacity 0.2s ease;
    white-space: nowrap;
  }
  .pmd-code-box__btn:hover, .pmd-code-box__btn:focus-visible { opacity: 0.85; }
  .pmd-code-box__btn[data-pmd-copied="true"] { background: var(--pmd-accent); }
  .pmd-deadline { font-size: 14px; margin: 0 0 32px; letter-spacing: 0.025em; }
  .pmd-steps { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 750px) {
    .pmd-steps { grid-template-columns: repeat(3, 1fr); gap: 32px; }
  }
  .pmd-step { border: 1px solid var(--pmd-border); padding: 32px 24px; }
  .pmd-step__num {
    font-size: 32px;
    font-weight: 300;
    letter-spacing: 0.025em;
    margin: 0 0 12px;
    color: var(--pmd-text);
  }
  .pmd-step__title { font-size: 18px; font-weight: 400; margin: 0 0 8px; }
  .pmd-step__body { margin: 0; font-size: 15px; }
  .pmd-products { display: grid; grid-template-columns: 1fr; gap: 24px; }
  @media (min-width: 750px) {
    .pmd-products { grid-template-columns: repeat(3, 1fr); gap: 32px; }
  }
  .pmd-product {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--pmd-border);
    background: var(--pmd-bg);
    transition: opacity 0.2s ease;
  }
  .pmd-product:hover, .pmd-product:focus-visible { opacity: 0.9; }
  .pmd-product__media {
    aspect-ratio: 1 / 1;
    background: var(--pmd-bg-soft);
    overflow: hidden;
  }
  .pmd-product__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pmd-product__body { padding: 20px; display: flex; flex-direction: column; gap: 6px; }
  .pmd-product__title {
    font-size: 16px;
    font-weight: 400;
    margin: 0;
    letter-spacing: 0.015em;
  }
  .pmd-product__price { font-size: 15px; margin: 0; }
  .pmd-product__discount-note {
    font-size: 13px;
    margin: 4px 0 0;
    color: var(--pmd-text);
    opacity: 0.7;
  }
  .pmd-collection-block {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
  }
  @media (min-width: 990px) {
    .pmd-collection-block { grid-template-columns: 1fr 1fr; gap: 64px; }
    .pmd-collection-block--reverse .pmd-collection-block__text { order: 2; }
  }
  .pmd-collection-block__text .pmd-h2 { margin-bottom: 20px; }
  .pmd-faq { max-width: 760px; margin: 0 auto; }
  .pmd-faq__item { border-top: 1px solid var(--pmd-border); padding: 0; }
  .pmd-faq__item:last-child { border-bottom: 1px solid var(--pmd-border); }
  .pmd-faq__item summary {
    list-style: none;
    cursor: pointer;
    padding: 20px 32px 20px 0;
    font-size: 17px;
    font-weight: 400;
    position: relative;
  }
  .pmd-faq__item summary::-webkit-details-marker { display: none; }
  .pmd-faq__item summary::after {
    content: '+';
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 22px;
    font-weight: 300;
    transition: transform 0.2s ease;
  }
  .pmd-faq__item[open] summary::after { content: '−'; }
  .pmd-faq__answer { padding: 0 0 20px; margin: 0; font-size: 15px; max-width: 65ch; }
  .pmd-section--dark .pmd-h2 { color: var(--pmd-btn-text); }
  .pmd-section--dark .pmd-deadline,
  .pmd-section--dark .pmd-lead {
    color: var(--pmd-btn-text);
    opacity: 0.85;
  }
  .pmd-section--dark .pmd-code-box { border-color: var(--pmd-btn-text); }
  .pmd-section--dark .pmd-code-box__code { color: var(--pmd-btn-text); }
  .pmd-section--dark .pmd-code-box__btn {
    background: var(--pmd-btn-text);
    color: var(--pmd-btn-bg);
  }
  .pmd-market-block {
    text-align: center;
    padding: clamp(80px, 12vw, 140px) 16px;
    border-top: 1px solid var(--pmd-border);
    border-bottom: 1px solid var(--pmd-border);
  }
  .pmd-page :focus-visible { outline: 2px solid var(--pmd-accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) {
    .pmd-page * { transition: none !important; }
  }
</style>

<div class="pmd-page">

{%- if foreign_market -%}

  <section class="pmd-market-block">
    <div class="pmd-container">
      <p class="pmd-eyebrow">{{ campaign_eyebrow }}</p>
      <h1 class="pmd-h1">Denne kampanjen gjelder kun i Norge</h1>
      <p class="pmd-lead">Koden 17MAI er forbeholdt det norske markedet. Bla gjennom resten av utvalget vårt.</p>
      <div class="pmd-cta-row" style="justify-content:center;">
        <a href="/collections/all" class="pmd-btn pmd-btn--primary">Se alle produkter</a>
      </div>
    </div>
  </section>

{%- else -%}

  {%- comment -%} 1. HERO {%- endcomment -%}
  <section class="pmd-section pmd-hero">
    <div class="pmd-container">
      <p class="pmd-eyebrow">{{ campaign_eyebrow }}</p>
      <h1 class="pmd-h1">En liten gave til kundeklubben</h1>
      <p class="pmd-lead" style="margin-left:auto;margin-right:auto;">Som takk til alle som følger oss på e-post gir vi <span class="pmd-hero__highlight">17&nbsp;%</span> rabatt på tygg og hjernetrim. Bruk koden under i kassen.</p>

      <div class="pmd-code-box" role="group" aria-label="Rabattkode">
        <span class="pmd-code-box__code">{{ campaign_code }}</span>
        <button type="button" class="pmd-code-box__btn" data-pmd-copy="{{ campaign_code }}" aria-label="Kopier rabattkoden {{ campaign_code }}">Kopier</button>
      </div>
      <p class="pmd-deadline">Gyldig {{ campaign_deadline_text }}</p>

      <div class="pmd-cta-row" style="justify-content:center;">
        <a href="{{ campaign_cta }}" class="pmd-btn pmd-btn--primary">Se alle 17. mai-tilbud</a>
      </div>
    </div>
  </section>

  {%- comment -%} 2. SLIK BRUKER DU KODEN {%- endcomment -%}
  <section class="pmd-section pmd-section--soft pmd-section--center">
    <div class="pmd-container">
      <h2 class="pmd-h2">Slik bruker du koden</h2>
      <p class="pmd-lead">Tre raske trinn fra valg til levering.</p>

      <div class="pmd-steps">
        <div class="pmd-step">
          <p class="pmd-step__num">01</p>
          <h3 class="pmd-step__title">Velg fra tygg eller hjernetrim</h3>
          <p class="pmd-step__body">Bla gjennom utvalget og legg favorittene i handlekurven.</p>
        </div>
        <div class="pmd-step">
          <p class="pmd-step__num">02</p>
          <h3 class="pmd-step__title">Skriv inn koden {{ campaign_code }}</h3>
          <p class="pmd-step__body">I kassen finner du et felt for rabattkode. Skriv inn {{ campaign_code }} og trykk bruk.</p>
        </div>
        <div class="pmd-step">
          <p class="pmd-step__num">03</p>
          <h3 class="pmd-step__title">Bestill innen 17. mai</h3>
          <p class="pmd-step__body">Bestillinger lagt inn etter midnatt 17. mai får ikke rabatten.</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} 3. FEATURED PRODUKTER {%- endcomment -%}
  <section class="pmd-section pmd-section--center">
    <div class="pmd-container">
      <h2 class="pmd-h2">Tre favoritter til dagen</h2>
      <p class="pmd-lead">Fra utvalget som er med i kampanjen.</p>

      <div class="pmd-products">
        {%- for handle in featured_handles -%}
          {%- assign p = all_products[handle] -%}
          {%- if p != empty and p.available -%}
            <a href="{{ p.url }}" class="pmd-product">
              <div class="pmd-product__media">
                {%- assign img = p.featured_media.preview_image -%}
                {%- if img -%}
                  <img
                    src="{{ img | image_url: width: 800 }}"
                    srcset="{{ img | image_url: width: 400 }} 400w, {{ img | image_url: width: 600 }} 600w, {{ img | image_url: width: 800 }} 800w, {{ img | image_url: width: 1200 }} 1200w"
                    sizes="(min-width: 990px) 360px, (min-width: 750px) 33vw, calc(100vw - 32px)"
                    alt="{{ img.alt | default: p.title | escape }}"
                    loading="lazy"
                    width="{{ img.width }}"
                    height="{{ img.height }}"
                    class="pmd-product__img">
                {%- endif -%}
              </div>
              <div class="pmd-product__body">
                <h3 class="pmd-product__title">{{ p.title }}</h3>
                <p class="pmd-product__price">{{ p.price | money }}</p>
                <p class="pmd-product__discount-note">17&nbsp;% rabatt med koden {{ campaign_code }}</p>
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} 4. TYGG-BLOKK {%- endcomment -%}
  <section class="pmd-section pmd-section--soft">
    <div class="pmd-container">
      <div class="pmd-collection-block">
        <div class="pmd-collection-block__text">
          <h2 class="pmd-h2">Alt av tygg, <span class="pmd-hero__highlight">17&nbsp;%</span> rabatt</h2>
          <p class="pmd-lead">Naturlige tygg gir hunden noe meningsfullt å holde på med. De kan bidra til en roligere hverdag og er gode å ha til lengre stunder alene. I kategorien finner du alt fra korte godbiter til langvarige biter med vom og naturlige materialer.</p>
          <div class="pmd-cta-row">
            <a href="{{ tygg_cta }}" class="pmd-btn pmd-btn--primary">Se alle {{ tygg_count }} tygg</a>
          </div>
        </div>
        <div class="pmd-collection-block__media">
          {%- assign tygg_collection = collections[tygg_handle] -%}
          {%- if tygg_collection.image -%}
            <img
              src="{{ tygg_collection.image | image_url: width: 900 }}"
              srcset="{{ tygg_collection.image | image_url: width: 600 }} 600w, {{ tygg_collection.image | image_url: width: 900 }} 900w, {{ tygg_collection.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, calc(100vw - 32px)"
              alt="{{ tygg_collection.image.alt | default: 'Tygg til hund' | escape }}"
              loading="lazy"
              width="{{ tygg_collection.image.width }}"
              height="{{ tygg_collection.image.height }}"
              class="pmd-product__img">
          {%- elsif tygg_collection.products.first.featured_media.preview_image -%}
            {%- assign timg = tygg_collection.products.first.featured_media.preview_image -%}
            <img
              src="{{ timg | image_url: width: 900 }}"
              srcset="{{ timg | image_url: width: 600 }} 600w, {{ timg | image_url: width: 900 }} 900w, {{ timg | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, calc(100vw - 32px)"
              alt="{{ timg.alt | default: 'Tygg til hund' | escape }}"
              loading="lazy"
              width="{{ timg.width }}"
              height="{{ timg.height }}"
              class="pmd-product__img">
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} 5. HJERNETRIM-BLOKK {%- endcomment -%}
  <section class="pmd-section">
    <div class="pmd-container">
      <div class="pmd-collection-block pmd-collection-block--reverse">
        <div class="pmd-collection-block__text">
          <h2 class="pmd-h2">Hjernetrim som virker</h2>
          <p class="pmd-lead">Mental aktivisering tretter hunden minst like mye som en lang tur. Med slowfeedere, snusematter og puslespill kan du gjøre måltider og fritid til en liten utfordring som passer hver enkelt hund.</p>
          <div class="pmd-cta-row">
            <a href="{{ hjernetrim_cta }}" class="pmd-btn pmd-btn--primary">Se alle {{ hjernetrim_count }} hjernetrim</a>
          </div>
        </div>
        <div class="pmd-collection-block__media">
          {%- assign hjernetrim_collection = collections[hjernetrim_handle] -%}
          {%- if hjernetrim_collection.image -%}
            <img
              src="{{ hjernetrim_collection.image | image_url: width: 900 }}"
              srcset="{{ hjernetrim_collection.image | image_url: width: 600 }} 600w, {{ hjernetrim_collection.image | image_url: width: 900 }} 900w, {{ hjernetrim_collection.image | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, calc(100vw - 32px)"
              alt="{{ hjernetrim_collection.image.alt | default: 'Hjernetrim til hund' | escape }}"
              loading="lazy"
              width="{{ hjernetrim_collection.image.width }}"
              height="{{ hjernetrim_collection.image.height }}"
              class="pmd-product__img">
          {%- elsif hjernetrim_collection.products.first.featured_media.preview_image -%}
            {%- assign himg = hjernetrim_collection.products.first.featured_media.preview_image -%}
            <img
              src="{{ himg | image_url: width: 900 }}"
              srcset="{{ himg | image_url: width: 600 }} 600w, {{ himg | image_url: width: 900 }} 900w, {{ himg | image_url: width: 1200 }} 1200w"
              sizes="(min-width: 990px) 50vw, calc(100vw - 32px)"
              alt="{{ himg.alt | default: 'Hjernetrim til hund' | escape }}"
              loading="lazy"
              width="{{ himg.width }}"
              height="{{ himg.height }}"
              class="pmd-product__img">
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} 6. FAQ {%- endcomment -%}
  <section class="pmd-section pmd-section--soft pmd-section--center">
    <div class="pmd-container">
      <h2 class="pmd-h2">Vanlige spørsmål</h2>

      <div class="pmd-faq" style="text-align:left;">
        <details class="pmd-faq__item">
          <summary>Hvor lenge gjelder koden?</summary>
          <p class="pmd-faq__answer">Koden {{ campaign_code }} er gyldig {{ campaign_deadline_text }}. Bestillinger som legges inn etter midnatt 17. mai får ikke rabatten.</p>
        </details>

        <details class="pmd-faq__item">
          <summary>Hvilke produkter er inkludert?</summary>
          <p class="pmd-faq__answer">Rabatten gjelder hele utvalget i kategoriene tygg og hjernetrim. Den gjelder ikke andre kategorier som fôr eller pleie.</p>
        </details>

        <details class="pmd-faq__item">
          <summary>Kan koden kombineres med andre rabatter?</summary>
          <p class="pmd-faq__answer">Nei, koden {{ campaign_code }} kan ikke kombineres med andre aktive rabattkoder eller pågående salg. Du får automatisk den beste prisen i kassen.</p>
        </details>

        <details class="pmd-faq__item">
          <summary>Hvor raskt kommer pakken?</summary>
          <p class="pmd-faq__answer">Vi sender vanligvis innen 1 til 2 virkedager. Bestiller du innen 14. mai er du sikret levering før 17. mai til de fleste norske adresser.</p>
        </details>

        <details class="pmd-faq__item">
          <summary>Hva hvis pakken ikke rekker frem til 17. mai?</summary>
          <p class="pmd-faq__answer">Du får rabatten uansett, og pakken kommer så snart vi har sendt den. Vi anbefaler å bestille innen 14. mai for å være sikker på levering før 17. mai.</p>
        </details>
      </div>
    </div>
  </section>

  {%- comment -%} 7. AVSLUTTENDE TAKK {%- endcomment -%}
  <section class="pmd-section pmd-section--dark pmd-section--center">
    <div class="pmd-container">
      <p class="pmd-eyebrow">{{ campaign_eyebrow }}</p>
      <h2 class="pmd-h2">Takk for at du er med oss</h2>
      <p class="pmd-lead">Bruk koden under i kassen, gyldig {{ campaign_deadline_text }}.</p>

      <div class="pmd-code-box" role="group" aria-label="Rabattkode">
        <span class="pmd-code-box__code">{{ campaign_code }}</span>
        <button type="button" class="pmd-code-box__btn" data-pmd-copy="{{ campaign_code }}" aria-label="Kopier rabattkoden {{ campaign_code }}">Kopier</button>
      </div>

      <div class="pmd-cta-row" style="justify-content:center;margin-top:8px;">
        <a href="{{ campaign_cta }}" class="pmd-btn pmd-btn--primary">Handle nå</a>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var buttons = document.querySelectorAll('[data-pmd-copy]');
      if (!buttons.length) return;

      function legacyCopy(text) {
        var ta = document.createElement('textarea');
        ta.value = text;
        ta.setAttribute('readonly', '');
        ta.style.position = 'absolute';
        ta.style.left = '-9999px';
        document.body.appendChild(ta);
        ta.select();
        var ok = false;
        try { ok = document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
        return ok;
      }

      function flashSuccess(btn) {
        var original = btn.textContent;
        btn.textContent = 'Kopiert';
        btn.setAttribute('data-pmd-copied', 'true');
        setTimeout(function () {
          btn.textContent = original;
          btn.removeAttribute('data-pmd-copied');
        }, 2000);
      }

      Array.prototype.forEach.call(buttons, function (btn) {
        btn.addEventListener('click', function () {
          var code = btn.getAttribute('data-pmd-copy');
          if (!code) return;
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(function () {
              flashSuccess(btn);
            }, function () {
              if (legacyCopy(code)) flashSuccess(btn);
            });
          } else if (legacyCopy(code)) {
            flashSuccess(btn);
          }
        });
      });
    })();
  </script>

{%- endif -%}

</div>
